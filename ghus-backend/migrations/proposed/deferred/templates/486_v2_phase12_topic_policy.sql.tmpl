BEGIN;

INSERT INTO topic(code,name) VALUES
    @@TOPIC_VALUES@@
ON CONFLICT (code) DO NOTHING;

CREATE TEMP TABLE phase12_hub_topic(
    hub_id uuid PRIMARY KEY, topic_code text NOT NULL, center_city text NOT NULL,
    center_state_code text, center_latitude numeric(9,6) NOT NULL,
    center_longitude numeric(9,6) NOT NULL
) ON COMMIT DROP;
INSERT INTO phase12_hub_topic VALUES
    @@HUB_VALUES@@;

UPDATE hub h
SET topic_id = coalesce(h.topic_id, t.topic_id),
    center_city = coalesce(h.center_city, p.center_city),
    center_state_code = coalesce(h.center_state_code, p.center_state_code),
    center_latitude = coalesce(h.center_latitude, p.center_latitude),
    center_longitude = coalesce(h.center_longitude, p.center_longitude),
    center_method = coalesce(h.center_method, 'density_center'),
    center_method_version = coalesce(h.center_method_version, 'density_center_v1'),
    center_computed_at = coalesce(h.center_computed_at, now()),
    radius_miles = coalesce(h.radius_miles, @@RADIUS@@),
    center_frozen = coalesce(h.center_frozen, false),
    source_origin = coalesce(h.source_origin, 'imported_phase1')
FROM phase12_hub_topic p JOIN topic t ON t.code = p.topic_code
WHERE h.hub_id = p.hub_id;

UPDATE hub_actor ha
SET topic_id = coalesce(ha.topic_id, h.topic_id),
    distance_miles = coalesce(ha.distance_miles, round((2 * 3958.7613 * asin(sqrt(
        power(sin(radians(a.latitude - h.center_latitude) / 2), 2)
        + cos(radians(h.center_latitude)) * cos(radians(a.latitude))
          * power(sin(radians(a.longitude - h.center_longitude) / 2), 2))))::numeric, 2)),
    outside_radius = coalesce(ha.outside_radius, (2 * 3958.7613 * asin(sqrt(
        power(sin(radians(a.latitude - h.center_latitude) / 2), 2)
        + cos(radians(h.center_latitude)) * cos(radians(a.latitude))
          * power(sin(radians(a.longitude - h.center_longitude) / 2), 2)))) > h.radius_miles)
FROM hub h, actor a
WHERE ha.hub_id = h.hub_id AND a.actor_id = ha.actor_id
  AND h.hub_id IN (SELECT hub_id FROM phase12_hub_topic)
  AND a.latitude IS NOT NULL AND h.center_latitude IS NOT NULL;

UPDATE hub_actor ha
SET topic_id = coalesce(ha.topic_id, h.topic_id),
    assignment_outcome = coalesce(ha.assignment_outcome, 'legacy_membership_preserved')
FROM hub h
WHERE ha.hub_id = h.hub_id AND h.hub_id IN (SELECT hub_id FROM phase12_hub_topic);

-- Same actor in two hubs on the same topic: flag the overlap for GHUS, remove nothing.
UPDATE hub_actor ha
SET overlap_flag = EXISTS (
    SELECT 1 FROM hub_actor other
    WHERE other.actor_id = ha.actor_id AND other.hub_id <> ha.hub_id
      AND other.topic_id = ha.topic_id)
WHERE ha.overlap_flag IS NULL AND ha.topic_id IS NOT NULL;

