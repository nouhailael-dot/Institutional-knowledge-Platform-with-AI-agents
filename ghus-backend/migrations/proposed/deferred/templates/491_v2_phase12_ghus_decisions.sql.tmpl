-- PROPOSAL ONLY. GENERATED by scripts/phase12_ghus_decisions_sql.py; do not edit.
-- Source: docs/evidence/phase12_category_proposals.csv sha256 @@DIGEST@@
-- GHUS decisions of 2026-10-06 (@@DECIDER@@):
--   1. confirm the proposed category of the @@CONFIRM_COUNT@@ real organizations;
--   2. reject the @@AGGREGATE_COUNT@@ collections of organizations: a GHUS rejection event
--      (status becomes rejected), their hub memberships archived in hub_actor_removed
--      and removed from hub_actor. Rows stay because append-only ledgers reference them;
--   4. retire the empty "Mining Hubs" row (no sector, members or location), archived
--      in hub_removed.
-- Every decision is recorded; nothing is deleted without an archive row. Idempotent.
BEGIN;

CREATE TEMP TABLE phase12_ghus_decision(
    actor_id uuid PRIMARY KEY,
    proposed_category text,
    is_true_aggregate boolean NOT NULL
) ON COMMIT DROP;
INSERT INTO phase12_ghus_decision VALUES
    @@VALUES@@;

-- 1. Category confirmations.
WITH confirmed AS (
  SELECT r.review_item_id, r.entity_id, d.proposed_category
  FROM review_item r
  JOIN phase12_ghus_decision d ON d.actor_id = r.entity_id
  JOIN actor a ON a.actor_id = r.entity_id AND a.actor_category = d.proposed_category
  WHERE r.review_kind = 'category_doubt' AND r.status = 'pending' AND NOT d.is_true_aggregate
), decided AS (
  INSERT INTO review_item_decision(review_item_id,decision,decided_by,reason,decided_at)
  SELECT review_item_id,'resolve','@@DECIDER@@',
         'actor_category=' || proposed_category || ' confirmed', now()
  FROM confirmed RETURNING review_item_id
), resolved AS (
  UPDATE review_item SET status = 'resolved'
  WHERE review_item_id IN (SELECT review_item_id FROM decided) RETURNING entity_id
)
UPDATE actor a
SET category_needs_review = false,
    category_note = 'Category confirmed by GHUS on 2026-10-06 (Phase 12 proposal).',
    updated_at = now()
WHERE a.actor_id IN (SELECT entity_id FROM resolved);

-- 2. Collections of organizations: rejected by GHUS, memberships archived then removed.
CREATE TEMP TABLE phase12_rejected ON COMMIT DROP AS
SELECT r.review_item_id, r.entity_id AS actor_id
FROM review_item r
JOIN phase12_ghus_decision d ON d.actor_id = r.entity_id AND d.is_true_aggregate
WHERE r.review_kind = 'category_doubt' AND r.status = 'pending';

INSERT INTO actor_verification_event(actor_id,decision,decided_by,decided_at,reason,
                                     rejection_reason,decision_origin)
SELECT actor_id,'rejected','@@DECIDER@@',now(),'Phase 12 aggregate disposition',
       'Collection of organizations, not a single organization','ghus_review'
FROM phase12_rejected;

UPDATE actor SET category_note = 'Rejected by GHUS on 2026-10-06: collection of organizations.',
                 category_needs_review = false, updated_at = now()
WHERE actor_id IN (SELECT actor_id FROM phase12_rejected);

INSERT INTO hub_actor_removed(hub_id,actor_id,membership,reason,decided_by)
SELECT ha.hub_id, ha.actor_id, to_jsonb(ha),
       'member is a GHUS-rejected collection of organizations', '@@DECIDER@@'
FROM hub_actor ha JOIN actor a ON a.actor_id = ha.actor_id
WHERE a.status = 'rejected'
  AND a.actor_id IN (SELECT actor_id FROM phase12_ghus_decision WHERE is_true_aggregate)
ON CONFLICT (hub_id, actor_id) DO NOTHING;
DELETE FROM hub_actor ha USING hub_actor_removed removed
WHERE ha.hub_id = removed.hub_id AND ha.actor_id = removed.actor_id;

WITH decided AS (
  INSERT INTO review_item_decision(review_item_id,decision,decided_by,reason,decided_at)
  SELECT review_item_id,'resolve','@@DECIDER@@','disposition=rejected_collection',now()
  FROM phase12_rejected RETURNING review_item_id
)
UPDATE review_item SET status = 'resolved'
WHERE review_item_id IN (SELECT review_item_id FROM decided);

-- 4. Retire the empty "Mining Hubs" row.
DO $empty_hub$ BEGIN
  IF EXISTS (SELECT 1 FROM hub WHERE hub_id = '663e5dcd-7c09-435e-bc04-a1d30326c217'
             AND name = 'Mining Hubs')
     AND (EXISTS (SELECT 1 FROM hub_actor WHERE hub_id = '663e5dcd-7c09-435e-bc04-a1d30326c217')
       OR EXISTS (SELECT 1 FROM hub_funding WHERE hub_id = '663e5dcd-7c09-435e-bc04-a1d30326c217')
       OR EXISTS (SELECT 1 FROM hub_sector_strength WHERE hub_id = '663e5dcd-7c09-435e-bc04-a1d30326c217')
       OR EXISTS (SELECT 1 FROM hub_assignment_evidence WHERE hub_id = '663e5dcd-7c09-435e-bc04-a1d30326c217')
       OR EXISTS (SELECT 1 FROM hub_center_review WHERE hub_id = '663e5dcd-7c09-435e-bc04-a1d30326c217')
       OR EXISTS (SELECT 1 FROM proposed_hub WHERE final_hub_id = '663e5dcd-7c09-435e-bc04-a1d30326c217'))
  THEN
    RAISE EXCEPTION '491 refuses: "Mining Hubs" is no longer empty; GHUS must decide again';
  END IF;
END $empty_hub$;
INSERT INTO hub_removed(hub_id,hub,reason,decided_by)
SELECT hub_id, to_jsonb(h), 'empty legacy hub: no sector, members or location', '@@DECIDER@@'
FROM hub h WHERE hub_id = '663e5dcd-7c09-435e-bc04-a1d30326c217' AND name = 'Mining Hubs'
ON CONFLICT (hub_id) DO NOTHING;
DELETE FROM hub h USING hub_removed removed WHERE h.hub_id = removed.hub_id;

COMMIT;
