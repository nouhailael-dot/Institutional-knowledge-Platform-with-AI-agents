# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Supabase / Postgres ---
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the "Session pooler" or direct connection URI. Looks like:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Voyage AI (embeddings) ---
# Get from: https://dashboard.voyageai.com/  -> API Keys
VOYAGE_API_KEY=

# --- Anthropic (Claude) — the decided stack; used once funded ---
# Get from: https://console.anthropic.com/  -> API Keys
ANTHROPIC_API_KEY=

# --- Build the Map controlled Claude web search ---
# Live research stays off until an explicit live test is approved. It uses the
# ANTHROPIC_API_KEY above and one Claude web search per tracked request.
MAP_RESEARCH_ENABLED=0
MAP_SEARCH_PROVIDER=claude

# --- Agents reading websites (Build the Map and Discovery) ---
# The contact address both agents give websites they read, so a site owner can
# reach a person. Use a team mailbox, not a personal one. Discovery refuses to
# read pages without it; Build the Map then identifies without an address.
GHUS_AGENT_CONTACT_EMAIL=

# --- Discovery page -> GHUS backend (ghus-backend/) ---
# Absolute path to the ghus-backend folder of this repository, the backend's own
# Python (ghus-backend/.venv/bin/python), and the database requests are kept in.
GHUS_DISCOVERY_PROJECT_ROOT=
GHUS_DISCOVERY_PYTHON=
DISCOVERY_REQUESTS_DATABASE_URL=

# --- Human review ---
# REQUIRED IN ANY DEPLOYMENT. This file is DURABLE STATE, not a cache.
#
# It is the only place that records a reviewer's decision on a pre-promotion
# candidate. PostgreSQL re-serves every candidate on each sync, and the only
# reason a rejected one does not come back is that its row is in this file.
# Lose the file and every rejection silently becomes pending again - nothing
# errors, nothing is logged, and the queue simply forgets a human decision.
#
# Point it at storage that survives a deployment: a mounted volume or a
# persistent disk. NOT inside the application directory (a deploy replaces the
# working tree) and NOT under /tmp. Back it up - see
# docs/REVIEW_STORE_PERSISTENCE.md, and verify a backup with
# scripts/verify_review_store_backup.py.
#
# Left empty, the application falls back to <repo>/.review/review.sqlite3 and
# logs a warning at startup for every reason the location is not durable.
#
# Approval into the canonical database remains disabled until the DB owner
# installs sql/review_workflow.sql and wires a dedicated transactional
# admission writer.
REVIEW_STORE_DB=/var/lib/ghus/review.sqlite3

# Optional second RunStore to import into Review in strict SQLite read-only mode.
# This lets a separate original agent checkout remain the source of discoveries
# without allowing this application to recover or modify that checkout's jobs.
REVIEW_SOURCE_RUN_DB=

# Optional original-platform PostgreSQL discovery queues. Prefer pointing to
# the original checkout's private .env so no credential is copied. The Review
# adapter forces every connection into transaction_read_only mode and imports
# only into the local REVIEW_STORE_DB.
REVIEW_SOURCE_POSTGRES_ENV_FILE=
# Alternatively provide a dedicated read-only PostgreSQL role URL directly.
REVIEW_SOURCE_DATABASE_URL=

# Canonical decisions are fail-closed unless all three are configured after
# agents/sql/180_review_admission_workflow.sql has been reviewed and applied.
# Use the isolated feature checkout, never the original main working tree.
GHUS_ADMISSION_PROJECT_ROOT=
GHUS_ADMISSION_PYTHON=python
# Dedicated least-privilege writer role; do not reuse DATABASE_URL or the
# read-only REVIEW_SOURCE_DATABASE_URL.
REVIEW_ADMISSION_DATABASE_URL=

# --- Groq (free-tier LLM used for v0.1 answer generation) ---
# Get from: https://console.groq.com/keys
GROQ_API_KEY=
