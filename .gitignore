# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# OS / editor
.DS_Store
.vscode/
.idea/

# Streamlit
.streamlit/secrets.toml

# Local map jobs, sources, and usage records
.map_runs/

# Local human-review queue and audit records
.review/

# Isolated Review-page demonstration databases
.demo/

# Backups of the env file hold the real connection string.
.env.bak*

# A .venv that is a link, not a folder, and any variant of the env file
.venv
.env.*
!.env.example

# Request files the Review admission bridge writes before calling the backend
.review-requests/

# Office lock files (~$Book.xlsx) left while a document is open
~$*

# Local test caches and Windows temporary test directories
.pytest_cache/
pytest-of-*/
